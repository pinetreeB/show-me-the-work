{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Offline claims assist advisory judgments",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "verdict",
      "rationale"
    ],
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      },
      "verdict": {
        "type": "string",
        "enum": [
          "supported",
          "contradicted",
          "not_enough_evidence"
        ]
      },
      "evidence_quote": {
        "type": "string",
        "maxLength": 200
      },
      "evidence_ref": {
        "type": [
          "integer",
          "null"
        ],
        "minimum": 1
      },
      "rationale": {
        "type": "string",
        "maxLength": 120
      }
    }
  }
}
